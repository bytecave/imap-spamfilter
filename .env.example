# Secrets file (mode 600). Defaults:
#   Unraid:       /mnt/user/appdata/spamfilter/secrets/imap-spamfilter.env
#   ByteLord VPS: /opt/bytelord/secrets/imap-spamfilter.env
# For generic Linux, set SPAMFILTER_SECRETS to the chosen absolute path.
#
# RSPAMD_PASSWORD and REDIS_PASSWORD are required. Values use the same
# no-expansion dotenv parser in bootstrap and the filter: matching outer
# single/double quotes are removed; # is preserved and is only a comment at
# the start of a line. Quotes and backslashes are escaped when configs render.
# The generated Unraid defaults are 64-character hex strings.

RSPAMD_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING

# Optional dashboard (prefer state/dashboard_users via docker exec):
# DASHBOARD_USERS=user:pbkdf2$...:admin
