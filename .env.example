# ByteLord VPS secrets (mode 600). Copy to:
#   /opt/bytelord/secrets/imap-spamfilter.env
#
# Deploy with:
#   docker compose -f /opt/bytelord/compose/imap-spamfilter/compose.yaml up -d
#
# RSPAMD_PASSWORD and REDIS_PASSWORD are required. Bootstrap renders
# rspamd/redis configs from this file only (no copies under data/state).

RSPAMD_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING

# Optional dashboard (prefer state/dashboard_users via docker exec):
# DASHBOARD_USERS=user:pbkdf2$...:admin
