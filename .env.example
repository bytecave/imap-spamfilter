# Dev/laptop only. Copy next to docker-compose.yml if you want Compose's
# automatic .env loading on a clone. Production (VPS) should NOT use this
# path: put the same keys in a mode-600 file outside the git tree and pass
# it explicitly:
#
#   sudo install -d -m 700 /opt/bytelord/secrets
#   sudo install -m 600 /dev/null /opt/bytelord/secrets/imap-spamfilter.env
#   docker compose --env-file /opt/bytelord/secrets/imap-spamfilter.env up -d
#
# Leave RSPAMD_PASSWORD empty/unset to use bootstrap's
# state/controller.password. Generate a value only if you are not using
# that file: openssl rand -base64 48

# RSPAMD_PASSWORD=REPLACE_WITH_LONG_RANDOM_STRING
