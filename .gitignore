# Local runtime / secrets
.env
accounts.yml
rspamd/local.d/worker-controller.inc
rspamd/local.d/redis.conf

# Per-host data (Unraid appdata)
state/
redis-config/
# redis/ holds the appdata data dir; the checked-in server config
# template must stay tracked.
redis/*
!redis/redis.conf.template
rspamd/data/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Graphify knowledge-graph output / caches (never commit).
# Ignore any path whose name starts with or contains "graphify", but keep
# Cursor project rules under .cursor/ (including rules/graphify.mdc).
*graphify*
.*graphify*
!.cursor/
!.cursor/**
